# Meta App credentials (Meta App Dashboard > Settings > Basic)
# Both values are placeholders. Replace them with your own app's values.
META_APP_ID=000000000000000
META_APP_SECRET=your_app_secret_here

# Meta Marketing API configuration
META_API_VERSION=v22.0
META_API_MIN_REQUEST_INTERVAL_MS=1000
META_API_RATE_LIMIT_COOLDOWN_MS=60000

# OAuth callback URL. Must exactly match a Valid OAuth Redirect URI
# configured on your Meta app.
META_OAUTH_CALLBACK_URL=https://example.com/callback

# Optional: skip the OAuth flow by supplying a token you already hold.
# META_ACCESS_TOKEN=your_access_token_here

# SQLite database used to persist tokens between restarts
SQLITE_DB_PATH=./data/tokens.db

# Cap on a single MCP tool response before summarization (bytes, default 102400)
# MCP_RESPONSE_MAX_BYTES=102400

# HTTP transport only (pnpm start:http)
HOST=0.0.0.0
PORT=3001
