# Meta App Credentials (from Facebook Developer Console)
META_APP_ID=1234567890178
META_APP_SECRET=your_app_secret_here

# Meta API Configuration
META_API_VERSION=v22.0

# OAuth Callback URL (must match Facebook App settings)
META_OAUTH_CALLBACK_URL=https://example.com/callback

# Optional: Pre-configured access token (bypasses OAuth flow)
# META_ACCESS_TOKEN=your_access_token_here

# SQLite Database Path (for token storage)
SQLITE_DB_PATH=./data/tokens.db

# Server Configuration (for HTTP transport)
HOST=0.0.0.0
PORT=3001
