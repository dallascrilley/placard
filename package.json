{
  "name": "placard",
  "version": "0.1.0",
  "description": "MCP server that gives coding agents tools to build and manage Meta ad campaigns",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "placard": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dallascrilley/placard.git"
  },
  "bugs": {
    "url": "https://github.com/dallascrilley/placard/issues"
  },
  "homepage": "https://github.com/dallascrilley/placard#readme",
  "author": "Dallas Crilley",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/http.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:descriptions": "tsx scripts/validate-descriptions.ts",
    "smoke": "pnpm build && node scripts/smoke-test.mjs",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm validate:descriptions && node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^13.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "meta",
    "facebook",
    "instagram",
    "ads",
    "marketing-api",
    "advertising"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8"
}
